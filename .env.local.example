# ─────────────────────────────────────────────────────────────────────────────
# LUNARA — Client-side Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER place server secrets here (no Brevo API key, no service role key).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL and public anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# The deployed Lunara URL (used for magic-link auth redirects, metadata, OAuth, etc.)
# Local development:  http://localhost:3000
# Production:         https://prathamesh.xyz
#
# Must also be added to Supabase Dashboard → Authentication → URL Configuration:
#   Site URL:            https://prathamesh.xyz
#   Redirect URLs:       https://prathamesh.xyz/auth/callback
#   Additional (dev):    http://localhost:3000/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE SECRETS — configure in Supabase Edge Function secrets only
# ─────────────────────────────────────────────────────────────────────────────
# These MUST NOT be placed in this file or any NEXT_PUBLIC_ variable.
#
# Set via Supabase CLI:
#   supabase secrets set BREVO_API_KEY=your-key-here
#   supabase secrets set PARTNER_INVITE_FROM_EMAIL=no-reply@yourdomain.com
#   supabase secrets set PARTNER_INVITE_FROM_NAME="Lunara"
#   supabase secrets set APP_URL=https://yourdomain.com
#
# Or via Supabase Dashboard:
#   https://supabase.com/dashboard/project/<project-id>/settings/functions
